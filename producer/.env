# Kafka Producer Configuration Overrides
# This file is loaded automatically by producer.py via python-dotenv

# For LOCAL testing (docker-compose on your own machine):
KAFKA_BROKER=localhost:9092,localhost:9093,localhost:9094

# For TEAM testing (change to Person 2's ZeroTier IP when team is ready):
# KAFKA_BROKER=<PERSON_2_ZEROTIER_IP>:9092,<PERSON_2_ZEROTIER_IP>:9093,<PERSON_2_ZEROTIER_IP>:9094
